/* wld-cell.wxss */

.cell {
    /* CSS variables for easy theming */
    --cell-font-size: 28rpx;
    --cell-padding-vertical: 26rpx;
    --cell-padding-horizontal: 30rpx;
    --cell-gap: 30rpx;
    --cell-value-gap: 10rpx;
    --cell-line-height: 1.5;
    --cell-active-background: rgba(0, 0, 0, 0.05);

    display: flex;
    font-size: var(--cell-font-size);
    align-items: start;
    gap: var(--cell-gap);
    justify-content: space-between;
    padding: var(--cell-padding-vertical) var(--cell-padding-horizontal);
    width: 100%;
    box-sizing: border-box;
    border-radius: 32rpx;
}

/* Tappable feedback style */
.cell--tappable.cell--active {
    background-color: var(--cell-active-background);
}

.cell__label {
    font-weight: bold;
    word-break: keep-all; /* Prevents the label from breaking into multiple lines */
    white-space: nowrap;
    flex-shrink: 0; /* Prevents label from shrinking */
}

.cell__value {
    display: flex;
    justify-content: flex-end; /* Aligns value content to the right */
    align-items: center;
    text-align: right;
    gap: var(--cell-value-gap);
    flex-grow: 1;
    overflow: hidden;
}

.cell[data-type="info"] {
    padding: 16rpx var(--cell-padding-horizontal);
    color: var(--text-secondary);
}

.cell[data-type="info"] .cell__label {
    font-weight: normal;
}

.cell__value__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0; /* Prevents icons from shrinking */
}

.cell__value__text {
    flex-grow: 1;
}

.cell-chevron {
    background-image: url("data:image/svg+xml;base64,");
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    width: 20rpx;
    height: 36rpx;
    transition: transform 200ms ease;
}

.cell-chevron--rotated {
    transform: rotate(90deg);
}
