page {
  --theme-500: #ffcd00;
  --danger-500: #ff5a4f;
  --text-primary: rgba(0, 0, 0, 0.9);
  --text-secondary: rgba(0, 0, 0, 0.5);
  --text-tertiary: rgba(0, 0, 0, 0.35);
  font-family: system-ui, -apple-system, sans-serif;
  color: var(--text-primary);
  min-height: 100vh;
}

.wc-sans,
.wc-sans-ss,
.wc-sans-std {
  font-family: system-ui, -apple-system, sans-serif;
}
