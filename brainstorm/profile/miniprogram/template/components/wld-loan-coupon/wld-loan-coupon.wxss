.wld-loan-coupon {
    --cell-font-size: 28rpx;
    --cell-font-line-height: 39rpx;
    --cell-padding-vertical: 26rpx;
    --cell-padding-horizontal: 30rpx;
    font-size: var(--cell-font-size);
    line-height: var(--cell-font-line-height);
}

.wld-loan-coupon__main {
    padding: var(--cell-padding-vertical) var(--cell-padding-horizontal);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    font-weight: bold;
}

.wld-loan-coupon__main__left {
    display: flex;
    gap: 10rpx;
}

.wld-loan-coupon__main__right {
    display: flex;
    gap: 10rpx;
    align-items: center;
}

.coupon-icon {
    position: relative;
    background-image: url("data:image/svg+xml;base64,");
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    width: 40rpx;
    aspect-ratio: 1;
}

.coupon-label.coupon-label--disabled {
    color: var(--text-secondary);
    font-weight: normal;
}

.coupon-value {
    color: #ee8a27;
}

.coupon-value.coupon-value--disabled {
    color: var(--text-secondary);
    font-weight: normal;
}

.cell-chevron {
    background-image: url("data:image/svg+xml;base64,");
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    width: 20rpx;
    height: 36rpx;
}

.wld-loan-coupon__tip-wrap {
    position: relative;
    max-height: 130rpx;
    overflow: hidden;
    opacity: 1;
    transition:
        max-height 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.2s ease-out;
}

.wld-loan-coupon__tip-wrap--hidden {
    max-height: 0;
    opacity: 0;
    transition:
        max-height 0.15s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.1s ease-in;
}

.wld-loan-coupon__tip {
    position: relative;
    margin: 0 10rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
    font-size: 28rpx;
    border-radius: 22rpx;
    background: #fff6ee;
    padding: 20rpx;
}

.wld-loan-coupon__tip-arrow {
    content: "";
    position: absolute;
    bottom: -40rpx;
    left: 8rpx;
    border-radius: 4rpx;
    background: #fff6ee;
    width: 24rpx;
    height: 24rpx;
    transform: rotate(45deg);
    transition: opacity 0.15s ease-out;
}

.wld-loan-coupon__tip-arrow--hidden {
    opacity: 0;
}

.wld-loan-coupon__tip__button {
    color: #ee8a27;
    font-weight: bold;
    padding: 4rpx 16rpx;
    border-radius: 999px;
    border: 1px solid #ee8a27;
}

.wld-loan-coupon__tip__button--hover {
    background: #ee8a27;
    color: #fff;
}

.wld-loan-coupon__tip__text {
    flex: 1;
}
