.loan {
  padding: 28rpx 30rpx 260rpx;
}

.amount-card {
  margin: 18rpx 0 24rpx;
  padding: 36rpx 0 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.card,
.options-card {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx 60rpx calc(env(safe-area-inset-bottom, 24rpx) + 20rpx);
  background: linear-gradient(180deg, rgba(245, 245, 245, 0), #fff 20%);
  transition: 0.15s ease-out;
  transition-property: transform, opacity;
}

.bottom-bar--hidden {
  opacity: 0;
  transform: translateY(40%);
  pointer-events: none;
}

.keypad-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 16rpx env(safe-area-inset-bottom, 16rpx);
  transition: 0.15s ease-out;
  transition-property: transform, opacity;
}

.keypad-wrap--hidden {
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
}
