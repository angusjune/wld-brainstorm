<wld-page navTitle="借钱" navSubtitle="年利率(单利) {{rate}}%" background="#f5f5f5">
  <view class="loan">
    <view class="amount-card">
      <wld-amount-input
        value="{{inputVal}}"
        cursor="{{inputCursor}}"
        focus="{{focus}}"
        error="{{!inputValid}}"
        showErrorText="{{showErrorText}}"
        errorText="{{errorText}}"
        helperText="按天算利息，明天起可还"
        placeholder="最高可借{{shortenBalance}}"
        bind:focus="onFocusAmount"
        bind:tapchar="onTapChar"
      />
    </view>

    <view class="card" bindtap="openCouponDrawer">
      <wld-loan-coupon
        showValue="{{inputValid}}"
        label="前 30 天 0 利息"
        value="预计省 ¥138.60"
        shortenBalance="{{shortenBalance}}"
      />
    </view>

    <view class="options-card">
      <wld-loan-options
        repayDesc="{{repayDesc}}"
        bankCard="{{bankCard}}"
        usage="{{usage}}"
        bind:select="openOptionsDrawer"
        bind:tapusage="openUsageDrawer"
      />
    </view>
  </view>

  <view class="bottom-bar {{focus ? 'bottom-bar--hidden' : ''}}">
    <wld-button fullWidth size="large" showGlare disabled="{{!inputValid}}" bindtap="submit">下一步</wld-button>
    <wld-footer>年利率(单利) {{rate}}%</wld-footer>
  </view>
</wld-page>

<view class="keypad-wrap {{focus ? '' : 'keypad-wrap--hidden'}}">
  <wld-keypad
    balance="{{balance}}"
    value="{{inputVal}}"
    cursor="{{inputCursor}}"
    maxLength="6"
    bind:input="onKeypadInput"
    bind:confirm="submit"
    bind:hide="hideKeypad"
  />
</view>

<wld-drawer show="{{showDrawer}}" title="{{drawerTitle}}" subtitle="{{drawerSubtitle}}" bind:close="closeDrawer">
  <wld-select-group items="{{drawerItems}}" selectedIndex="{{drawerSelectedIndex}}" bind:selectOption="onDrawerSelect" />
</wld-drawer>
