{
  "name": "wld-brainstorm",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit && npm run sync:version",
    "sync:version": "node scripts/sync-plugin-version.mjs",
    "check:version": "node scripts/sync-plugin-version.mjs --check",
    "test": "node --test scripts/tests/*.test.mjs && npm --prefix site test",
    "screens:dev": "node scripts/dev-screens.cjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
