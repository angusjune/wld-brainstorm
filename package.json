{
  "name": "wld-design-plugin",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "eval": "node scripts/run-evals.mjs",
    "test:qa-gate": "npm --prefix plugins/wld-design/skills/brainstorm run test:qa-gate",
    "test:ui-report": "npm --prefix plugins/wld-design/skills/brainstorm run test:quality-benchmark",
    "test": "npm run build && npm run validate && npm run test:qa-gate",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  }
}
