---
// Thin wrapper around a build-time heerich SVG string.
// The SVG is rendered inline (no client JS, no external requests).
interface Props {
  svg: string
  label?: string
  class?: string
}
const { svg, label, class: className } = Astro.props
---
{label ? (
  <div class:list={['voxel', className]} role="img" aria-label={label} set:html={svg} />
) : (
  <div class:list={['voxel', className]} aria-hidden="true" set:html={svg} />
)}

<style>
  .voxel {
    display: block;
    line-height: 0;
  }
  .voxel :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
