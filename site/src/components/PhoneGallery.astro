---
import PhoneFrame from './PhoneFrame.astro'
interface Props { screens: { screen: string; caption?: string }[] }
const { screens } = Astro.props
---
<div class="phone-gallery">
  {screens.map(({ screen, caption }) => <PhoneFrame screen={screen} caption={caption} />)}
</div>

<style>
  .phone-gallery {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    padding: 16px 4px 24px;
    scroll-snap-type: x mandatory;
  }
  .phone-gallery > :global(*) { scroll-snap-align: center; flex-shrink: 0; }
</style>
