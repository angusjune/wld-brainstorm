---
interface Props { screen: string; caption?: string; scale?: number }
const { screen, caption, scale = 0.5 } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const src = encodeURI(`${base}/demo/${screen}.html`)
---
<figure class="phone-frame" style={`--scale: ${scale}`}>
  <div class="phone-bezel">
    <iframe src={src} loading="lazy" title={caption ?? screen}></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Bezel look matches plugins/wld-design/assets/phone-mockup.css */
  .phone-frame { margin: 0; width: calc(395px * var(--scale)); }
  .phone-bezel {
    background: #1a1a1a;
    border-radius: calc(40px * var(--scale));
    padding: calc(12px * var(--scale)) calc(10px * var(--scale));
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.08), 0 20px 60px rgba(0, 0, 0, 0.5);
    width: calc(395px * var(--scale));
    height: calc(836px * var(--scale));
    overflow: hidden;
  }
  iframe {
    display: block;
    width: 375px;
    height: 812px;
    border: 0;
    border-radius: 28px; /* scaled by the transform → effective 28px × scale */
    background: #fff;
    transform: scale(var(--scale));
    transform-origin: top left;
    pointer-events: none;
  }
  figcaption {
    text-align: center;
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-2);
  }
</style>
