---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PhoneGallery from '../../components/PhoneGallery.astro'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }))
}

const { skill } = Astro.props
const { Content } = await render(skill)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<Base title={`/${skill.data.name} — WLD Design 插件`}>
  <main class="container skill-page">
    <p><a href={`${base}/`}>← 返回</a></p>
    <span class="badge">{skill.data.stage}</span>
    <h1>/{skill.data.name}</h1>
    <p class="section-sub">{skill.data.tagline}</p>
    {skill.data.deps.length > 0 && <p class="deps">依赖：{skill.data.deps.join('、')}</p>}
    <article><Content /></article>
    {skill.data.demo === 'screens' && (
      <section class="demo-section">
        <h2>真机演示</h2>
        <PhoneGallery screens={skill.data.demoScreens.map((s) => ({ screen: s, caption: s }))} />
      </section>
    )}
    {skill.data.demo === 'arena' && (
      <section class="demo-section">
        <h2>真机演示</h2>
        <iframe class="arena-embed" src={`${base}/demo/beyblade/arena.html`} title="界面战斗陀螺" loading="lazy"></iframe>
      </section>
    )}
  </main>
</Base>

<style>
  .skill-page { padding: 64px 24px; max-width: 760px; }
  .skill-page h1 { font-size: 36px; margin: 12px 0 4px; }
  .skill-page a { color: var(--gold); }
  .deps { color: var(--text-2); font-size: 14px; }
  article :global(h2) { margin: 32px 0 12px; font-size: 20px; }
  article :global(ul), article :global(ol) { padding-left: 24px; }
  article :global(li) { margin-bottom: 6px; }
  article :global(code) { background: rgba(255, 255, 255, 0.08); padding: 1px 6px; border-radius: 6px; font-size: 0.9em; }
  .demo-section { margin-top: 32px; padding: 0; }
  .demo-section h2 { margin: 32px 0 12px; font-size: 20px; }
  .arena-embed { width: 100%; height: 720px; border: 0; border-radius: 16px; background: var(--navy); }
</style>
