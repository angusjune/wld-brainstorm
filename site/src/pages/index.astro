---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Voxel from '../components/Voxel.astro'
import HeroMorph from '../components/HeroMorph.astro'
import CopyCommand from '../components/CopyCommand.astro'
import { glyphScene } from '../lib/voxel.js'
import sessionVisual from '../assets/session-visual.png'
import sessionUx from '../assets/session-ux.png'

const steps = [
  {
    marker: glyphScene('clarify'),
    title: '澄清需求',
    body: '一次问清核心动作、页面数量、要展示的数据。已经说明白的就跳过，回复「默认」即可开始。',
  },
  {
    marker: glyphScene('align'),
    title: '对齐生产模板',
    body: '读取 assets/screens/ 的生产环境 HTML 模板与 PROFILE.md 规范，再按页面提取关联的业务规律与易错点，确保视觉和逻辑都不偏离微粒贷。',
  },
  {
    marker: glyphScene('three'),
    title: '生成 3 个方案',
    body: '依据需求给出 3 个不同方向，自动注入微信顶栏与手机外壳。交付前内部先跑一遍 Simplify 精简与 Fix Details 细节校验。',
  },
  {
    marker: glyphScene('finalize'),
    title: '定稿',
    body: '选定方向后展开完整流程页面，同样经过精简与校验，浏览器里通过 SSE 热更新实时预览。',
  },
  {
    marker: glyphScene('branch'),
    title: '延展到四个分支',
    body: '定稿后无缝接续下一段工作流 —— 不需要切换到别的技能。',
  },
]

const branches = [
  { tag: 'A', name: '反馈迭代', desc: '在终端里给反馈，改同一份 HTML，浏览器热更新。' },
  { tag: 'B', name: '推送 Figma', desc: '把定稿页面画成本地 Figma 画布里可编辑的 frame。' },
  { tag: 'C', name: '小程序 Demo', desc: '从定稿页面生成微信小程序 Demo，手机里能点。' },
  { tag: 'D', name: '爆旋陀螺 Battle', desc: '把方案变成爆旋陀螺进行混战。' },
]

// Real entries from the bundled product-knowledge snapshot
// (brainstorm/assets/pm-memory-cache/common-pitfalls.yaml) — not invented.
const pitfalls = [
  {
    id: 'PIT-001',
    tag: '空态 · CTA',
    desc: '未输入金额的空状态下，底部「下一步」默认禁用（浅黄色）—— 不能假设可点击，也不该把空状态连到提交流程。',
    fix: '空状态不设指向 SUBMITTING 的 transition，只有已填入金额才能提交。',
  },
  {
    id: 'PIT-002',
    tag: '浮层 · 状态识别',
    desc: '底部浮层（Sheet）常被漏识别为独立状态，只盯着主页面截图看。',
    fix: '每个浮层都建独立状态 + 弹出 / 关闭 transition；有异步加载再拆 LOADING / LOADED / ERROR。',
  },
  {
    id: 'PIT-003',
    tag: '首借 / 非首借 · 键盘',
    desc: '首借与非首借的键盘 CTA 不同：「确定」只收起键盘，「下一步」直接提交，容易被合并成同一种状态。',
    fix: '拆成 EDITING_FIRST 与 EDITING_RELOAN 两个独立状态，各记各的提交行为。',
  },
  {
    id: 'PIT-004',
    tag: '存量改动 · 影响链',
    desc: '分析存量改动时只看 PM 直接点名的组件（tier-1），漏掉 depends_on 关联的间接影响（tier-2）。',
    fix: '影响地图分两层输出，tier-1 与 tier-2 一并给 PM 确认改动范围。',
  },
]
---
<Base>
  <main>
    <!-- 1. Hero -->
    <section id="hero" class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">微粒贷设计 Skill</p>
          <h1 class="hero-title">/Brainstorm</h1>
          <p class="hero-lead">
            头脑风暴设计 Skill。说出想法，它先澄清需求、对齐生产模板，
            生成高质量的设计方案。
          </p>
          <div class="hero-actions">
            <!-- <a class="btn btn-gold" href="#start">开始使用</a> -->
          </div>
        </div>
        <div class="hero-art">
          <HeroMorph />
        </div>
      </div>
    </section>

    <!-- 上手 -->
    <section id="start">
      <div class="container">
        <p class="eyebrow">Get Started</p>
        <h2 class="section-title">安装使用</h2>
        <p class="section-sub">一个自包含目录，复制即用，不依赖任何外部技能。</p>

        <ol class="start-steps">
          <li>
            把 <code>brainstorm/</code> 复制到你的 agent 技能目录，例如
            <code>.claude/skills/</code>。
          </li>
          <li>在对话里用 <code>/brainstorm</code> 开始，直接描述你要设计的界面。</li>
        </ol>

        <p class="start-hint">试试这样说：</p>
        <CopyCommand command="/brainstorm 帮我设计一个微粒贷的新用户引导页，首次打开时推荐借款额度" />
        <CopyCommand command="/brainstorm 基于这个设计多出几个不同的方案：https://figma.com/design/xxxx" />
      </div>
    </section>

    <!-- 2. 真实会话产出 -->
    <section id="proof">
      <div class="container">
        <p class="eyebrow">Proof</p>
        <h2 class="section-title">真实会话产出</h2>
        <p class="section-sub">
          这些不是概念图，而是一次真实运行会话里生成的三方案对比 —— 直接在浏览器里翻看、比较、挑选。
        </p>

        <figure class="shot">
          <figcaption class="shot-cap">
            <span class="shot-mode">视觉探索</span>
            同一流程的三种视觉处理 · 方案 A 卡片承接 / B 状态优先 / C 金额聚焦
          </figcaption>
          <Image
            src={sessionVisual}
            alt="一次真实会话生成的三方案视觉对比：方案 A 卡片承接、方案 B 状态优先、方案 C 金额聚焦"
            widths={[640, 1040, 2080]}
            sizes="(max-width: 900px) 92vw, 1040px"
            format="webp"
          />
        </figure>

        <figure class="shot">
          <figcaption class="shot-cap">
            <span class="shot-mode">UX 探索</span>
            三种任务组织方式 · 方案 A 验证任务 / B 流程接续 / C 轻提示
          </figcaption>
          <Image
            src={sessionUx}
            alt="一次真实会话生成的三方案 UX 对比：方案 A 验证任务、方案 B 流程接续、方案 C 轻提示"
            widths={[640, 1040, 2080]}
            sizes="(max-width: 900px) 92vw, 1040px"
            format="webp"
          />
        </figure>
      </div>
    </section>

    <!-- 3. 工作流 -->
    <section id="workflow">
      <div class="container">
        <p class="eyebrow">Workflow</p>
        <h2 class="section-title">工作流</h2>
        <p class="section-sub">
          澄清 → 对齐生产模板 → 3 个方案（自动精简 + 细节校验）→ 定稿 → 四个分支。
        </p>

        <ol class="steps">
          {steps.map((step) => (
            <li class="step">
              <Voxel svg={step.marker} class="step-marker" />
              <div class="step-body">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="branches">
          {branches.map((b) => (
            <div class="card branch">
              <span class="branch-tag">{b.tag}</span>
              <h3>{b.name}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. 它懂微粒贷 -->
    <section id="knowledge">
      <div class="container">
        <p class="eyebrow">Product Knowledge</p>
        <h2 class="section-title">内置产品规则</h2>
        <p class="section-sub">
          Skill 带着内置产品知识快照跑：状态机、产品规律、历史易错点。
          下面是快照里真实记录的易错点 —— 每一条都来自过往被纠正过的设计。
        </p>
      </div>

      <div class="pit-carousel" role="group" aria-label="常见易错点，自动滚动">
        <div class="pit-track">
          {[...pitfalls, ...pitfalls].map((p, i) => (
            <article class="pit-card" aria-hidden={i >= pitfalls.length ? 'true' : undefined}>
              <div class="pit-card-head">
                <span class="badge">{p.id}</span>
                <span class="pit-tag">{p.tag}</span>
              </div>
              <p class="pit-desc">{p.desc}</p>
              <p class="pit-fix"><span class="pit-fix-label">纠正</span>{p.fix}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. 彩蛋 -->
    <section id="egg" class="beyblade">
      <div class="container">
        <p class="eyebrow">Easter Egg</p>
        <h2 class="section-title">不确定用哪个方案？</h2>
        <p class="section-sub">
          把界面变成爆旋陀螺打一场，哪个赢了用哪个。
        </p>
        <div class="arena-slot" id="arena-slot">
          <button type="button" id="arena-start">▶ 开战</button>
        </div>
      </div>
    </section>

    <script>
      const slot = document.getElementById('arena-slot')
      const btn = document.getElementById('arena-start')
      const base = import.meta.env.BASE_URL.replace(/\/$/, '')
      btn?.addEventListener('click', () => {
        const iframe = document.createElement('iframe')
        iframe.src = `${base}/demo/beyblade/arena.html`
        iframe.title = '界面战斗陀螺'
        slot?.replaceChildren(iframe)
      })
    </script>
  </main>
</Base>

<style>
  /* 1. Hero */
  .hero {
    border-top: 0;
    padding: clamp(88px, 14vh, 160px) 0 120px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.04;
    letter-spacing: 0.01em;
    margin-bottom: 28px;
  }
  .hero-lead {
    font-size: 17px;
    color: var(--text-2);
    max-width: 46ch;
    margin-bottom: 36px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  /* Voxel/HeroMorph render child component roots, which Astro's cid
     scoping misses — scope via the ancestor instead. */
  .hero-art :global(.hero-morph) {
    width: 100%;
    max-width: 380px;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    padding: 13px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-gold {
    background: var(--gold);
    color: rgba(0, 0, 0, 0.9);
  }
  .btn-gold:hover {
    background: var(--gold-deep);
  }
  .btn-line {
    border: 1px solid var(--line);
    color: var(--text);
  }
  .btn-line:hover {
    border-color: var(--text-2);
  }

  /* 2. Proof — screenshots */
  .shot {
    margin: 0 0 56px;
  }
  .shot:last-child {
    margin-bottom: 0;
  }
  .shot-cap {
    font-size: 14px;
    color: var(--text-2);
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .shot-mode {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--gold-deep);
    border-radius: 999px;
    padding: 3px 12px;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  /* 3. Workflow */
  .steps {
    list-style: none;
    display: grid;
    gap: 4px;
    margin: 0 0 64px;
  }
  .step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 28px 0;
    border-top: 1px solid var(--line-soft);
  }
  .step:first-child {
    border-top: 0;
  }
  .step :global(.step-marker) {
    width: 64px;
    height: 48px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .step-body h3 {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .step-body p {
    color: var(--text-2);
    font-size: 15px;
    max-width: 62ch;
  }

  .branches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }
  .branch {
    position: relative;
  }
  .branch-tag {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text-3);
    letter-spacing: 0.1em;
  }
  .branch h3 {
    margin-top: 6px;
  }

  /* 4. Product knowledge */
  .badge {
    display: inline-block;
    font-size: 12px;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--gold-tint);
    color: var(--gold);
  }

  /* Auto-scrolling pitfall carousel — pure-CSS marquee. The track holds
     two copies of the list; translating it -50% loops seamlessly. */
  .pit-carousel {
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .pit-track {
    display: flex;
    width: max-content;
    padding: 4px 24px;
    animation: pit-scroll 48s linear infinite;
  }
  .pit-carousel:hover .pit-track,
  .pit-carousel:focus-within .pit-track {
    animation-play-state: paused;
  }
  @keyframes pit-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .pit-card {
    flex: 0 0 340px;
    /* Uniform slot width (card + margin) so -50% lands exactly one set over. */
    margin-right: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }
  .pit-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pit-tag {
    font-size: 12px;
    color: var(--text-3);
    letter-spacing: 0.02em;
  }
  .pit-desc {
    font-size: 14px;
    color: var(--text);
    line-height: 1.7;
  }
  .pit-fix {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.7;
  }
  .pit-fix-label {
    margin-right: 8px;
    color: var(--gold);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .pit-carousel {
      -webkit-mask: none;
      mask: none;
    }
    .pit-track {
      flex-wrap: wrap;
      width: auto;
      gap: 16px;
      padding: 4px 24px;
      max-width: 1080px;
      margin: 0 auto;
      animation: none;
    }
    .pit-card {
      flex: 1 1 300px;
      margin-right: 0;
    }
    /* Drop the duplicated set when it can't scroll. */
    .pit-card[aria-hidden='true'] {
      display: none;
    }
  }

  /* 6. Get started */
  .start-steps {
    counter-reset: step;
    list-style: none;
    display: grid;
    gap: 14px;
    margin: 0 0 40px;
    max-width: 640px;
  }
  .start-steps li {
    position: relative;
    padding-left: 44px;
    padding-top: 4px;
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.8;
  }
  .start-steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 2px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text);
  }
  .start-steps code {
    color: var(--gold);
    font-size: 13px;
    background: var(--gold-tint);
    padding: 1px 7px;
    border-radius: 4px;
  }
  .start-hint {
    color: var(--text-3);
    font-size: 14px;
    margin-bottom: 12px;
  }

  /* 7. Beyblade */
  .beyblade .arena-slot {
    background: #05090d;
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .beyblade .arena-slot :global(iframe) {
    width: 100%;
    height: 720px;
    border: 0;
    border-radius: 8px;
  }
  .beyblade #arena-start {
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font-size: 17px;
    padding: 14px 38px;
    border-radius: 999px;
    cursor: pointer;
  }
  .beyblade #arena-start:hover {
    background: var(--gold-tint);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-art {
      order: -1;
    }
    .hero-art :global(.hero-morph) {
      max-width: 260px;
    }
  }
</style>
