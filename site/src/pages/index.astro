---
import { Image } from 'astro:assets'
import packageJson from '../../../package.json'
import Base from '../layouts/Base.astro'
import HeroMorph from '../components/HeroMorph.astro'
import CopyCommand from '../components/CopyCommand.astro'
import { glyphScene } from '../lib/voxel.js'
import sessionVisual from '../assets/session-visual.png'
import sessionUx from '../assets/session-ux.png'

const steps = [
  {
    marker: glyphScene('clarify'),
    title: '澄清需求',
    body: '围绕核心动作、页面状态、业务数据与非目标逐层确认，直到设计树没有被默默假设的分支。',
  },
  {
    marker: glyphScene('align'),
    title: '选择产品档案',
    body: '优先读取工作区 wld-design-profile；未创建时使用插件内置档案。再从 profile/screens/ 选择最接近的生产模板。',
  },
  {
    marker: glyphScene('three'),
    title: '生成 3 个方案',
    body: '从同一需求生成三个真正不同的方向，自动装配页面外壳、平台顶栏和手机预览，不靠换颜色制造差异。',
  },
  {
    marker: glyphScene('finalize'),
    title: '校验并比较',
    body: '确定性装配、规则检查、浏览器渲染和截图校验全部通过后再展示；用户可比较并选定方向。',
  },
  {
    marker: glyphScene('branch'),
    title: '继续反馈或推送 Figma',
    body: '直接在预览页点选元素写批注，继续修改同一组三方案；选定方向后也可以推送成可编辑的 Figma frame。',
  },
]

const branches = [
  { tag: 'A', name: '反馈迭代', desc: '输入反馈或在预览页直接点元素批注；同一 run 原地更新并热刷新。' },
  { tag: 'B', name: '推送 Figma', desc: '把选定方向画成本地 Figma 画布里可编辑的 frame。' },
]

const skills = [
  {
    command: '$setup-profile',
    label: '01 · 产品档案',
    title: '把设计上下文放进工作区',
    body: '初始化可编辑的产品档案，或根据 Figma、截图、HTML 和文字说明添加生产页面模板、Token 与组件。',
  },
  {
    command: '$brainstorm',
    label: '02 · 方案探索',
    title: '从真实模板出发做设计',
    body: '澄清需求、生成三个方向、在浏览器比较和批注，选定后可继续反馈、推送 Figma 或交给产品分支。',
  },
  {
    command: '$wtf',
    label: '03 · 重新说明',
    title: '让 AI 把话说清楚',
    body: '上一段没有听懂时直接调用，用更短、更具体的语言重新说明当前结论与下一步。',
  },
]

---
<Base>
  <header class="site-nav">
    <div class="container site-nav-inner">
      <a class="site-brand" href="#hero">WLD DESIGN</a>
      <nav aria-label="页面导航">
        <a href="#skills">三个 Skill</a>
        <a href="#proof">产出</a>
        <a href="#workflow">工作流</a>
        <a href="#start">安装</a>
      </nav>
      <span class="version">v{packageJson.version}</span>
    </div>
  </header>
  <main>
    <!-- 1. Hero -->
    <section id="hero" class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">WLD Design 插件 · v{packageJson.version}</p>
          <h1 class="hero-title">Design with<br /><span>/Brainstorm</span></h1>
          <p class="hero-lead">
            一次安装，获得产品档案、设计脑暴与清晰表达三个 Skill。
            从真实生产模板出发，把一句想法变成可比较、可批注、可验证的界面。
          </p>
          <div class="hero-actions">
            <a class="btn btn-gold" href="#start">安装插件</a>
            <a class="btn btn-line" href="#proof">查看真实产出</a>
          </div>
        </div>
        <div class="hero-art">
          <HeroMorph />
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills">
      <div class="container">
        <p class="eyebrow">三个 Skill</p>
        <h2 class="section-title">三个入口，一套设计上下文</h2>
        <p class="section-sub">产品档案只维护一份；建档、探索与解释都围绕同一份上下文工作。</p>

        <div class="skills-grid">
          {skills.map((skill) => (
            <article class="skill-card">
              <p class="skill-label">{skill.label}</p>
              <code>{skill.command}</code>
              <h3>{skill.title}</h3>
              <p>{skill.body}</p>
            </article>
          ))}
        </div>

        <p class="start-hint">第一次使用，先建立工作区产品档案：</p>
        <CopyCommand command="$setup-profile" />
        <p class="start-hint prompt-hint">然后直接描述要探索的界面：</p>
        <CopyCommand command="$brainstorm 强化个人中心的限时降价优惠样式" />
      </div>
    </section>

    <!-- 2. 真实会话产出 -->
    <section id="proof">
      <div class="container">
        <p class="eyebrow">真实产出</p>
        <h2 class="section-title">真实会话产出</h2>
        <p class="section-sub">
          这些不是概念图，而是一次真实运行会话里生成的三方案对比 —— 直接在浏览器里翻看、比较、挑选。
        </p>

        <figure class="shot">
          <figcaption class="shot-cap">
            <span class="shot-mode">视觉探索</span>
            同一流程的三种视觉处理 · 方案 A 卡片承接 / B 状态优先 / C 金额聚焦
          </figcaption>
          <Image
            src={sessionVisual}
            alt="一次真实会话生成的三方案视觉对比：方案 A 卡片承接、方案 B 状态优先、方案 C 金额聚焦"
            widths={[640, 1040, 2080]}
            sizes="(max-width: 900px) 92vw, 1040px"
            format="webp"
          />
        </figure>

        <figure class="shot">
          <figcaption class="shot-cap">
            <span class="shot-mode">UX 探索</span>
            三种任务组织方式 · 方案 A 验证任务 / B 流程接续 / C 轻提示
          </figcaption>
          <Image
            src={sessionUx}
            alt="一次真实会话生成的三方案 UX 对比：方案 A 验证任务、方案 B 流程接续、方案 C 轻提示"
            widths={[640, 1040, 2080]}
            sizes="(max-width: 900px) 92vw, 1040px"
            format="webp"
          />
        </figure>
      </div>
    </section>

    <!-- 3. 工作流 -->
    <section id="workflow">
      <div class="container">
        <p class="eyebrow">工作流</p>
        <h2 class="section-title">工作流</h2>
        <p class="section-sub">
          澄清 → 选择产品档案与生产模板 → 3 个方案 → 确定性校验 → 选定方向 → 反馈或推送 Figma。
        </p>

        <ol class="steps">
          {steps.map((step) => (
            <li class="step">
              <div class="step-marker" aria-hidden="true" set:html={step.marker} />
              <div class="step-body">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="branches">
          {branches.map((b) => (
            <div class="card branch">
              <span class="branch-tag">{b.tag}</span>
              <h3>{b.name}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 安装 -->
    <section id="start">
      <div class="container">
        <p class="eyebrow">开始使用</p>
        <h2 class="section-title">安装 WLD Design 插件</h2>
        <p class="section-sub">从插件市场安装后，三个 Skill 会一起出现；不再复制单独的 Skill 目录。</p>

        <div class="install-grid">
          <article class="install-card">
            <p class="install-label">Codex Desktop</p>
            <h3>从 Personal Marketplace 安装</h3>
            <ol class="start-steps">
              <li>打开侧边栏 Plugins，点击 Add → Add a marketplace。</li>
              <li>输入 <code>angusjune/wld-brainstorm</code>，回到 Personal 标签安装插件。</li>
            </ol>
          </article>

          <article class="install-card">
            <p class="install-label">Codex CLI</p>
            <h3>添加市场，再进入插件面板</h3>
            <CopyCommand command="codex plugin marketplace add angusjune/wld-brainstorm" />
            <CopyCommand command="/plugins" />
          </article>

          <article class="install-card">
            <p class="install-label">Claude Code</p>
            <h3>添加市场并重新加载</h3>
            <CopyCommand command="/plugin marketplace add angusjune/wld-brainstorm" />
            <CopyCommand command="/reload-plugins" />
          </article>
        </div>
      </div>
    </section>

    <!-- 7. 彩蛋 -->
    <section id="egg" class="beyblade">
      <div class="container">
        <p class="eyebrow">彩蛋</p>
        <h2 class="section-title">不确定用哪个方案？</h2>
        <p class="section-sub">
          把界面变成爆旋陀螺打一场，哪个赢了用哪个。
        </p>
        <div class="arena-slot" id="arena-slot">
          <button type="button" id="arena-start">▶ 开战</button>
        </div>
      </div>
    </section>

    <script>
      const slot = document.getElementById('arena-slot')
      const btn = document.getElementById('arena-start')
      const base = import.meta.env.BASE_URL.replace(/\/$/, '')
      btn?.addEventListener('click', () => {
        const iframe = document.createElement('iframe')
        iframe.src = `${base}/demo/beyblade/arena.html`
        iframe.title = '界面战斗陀螺'
        slot?.replaceChildren(iframe)
      })
    </script>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span>WLD Design 插件 · v{packageJson.version}</span>
      <a href="https://github.com/angusjune/wld-brainstorm">GitHub</a>
    </div>
  </footer>
</Base>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line-soft);
    background: rgba(13, 16, 20, 0.88);
    backdrop-filter: blur(16px);
  }
  .site-nav-inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .site-brand {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-decoration: none;
  }
  .site-nav nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
  }
  .site-nav nav a {
    color: var(--text-2);
    font-size: 13px;
    text-decoration: none;
  }
  .site-nav nav a:hover {
    color: var(--text);
  }
  .version {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    color: var(--text-3);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  /* 1. Hero */
  .hero {
    border-top: 0;
    padding: clamp(72px, 12vh, 140px) 0 120px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.04;
    letter-spacing: 0.01em;
    margin-bottom: 28px;
  }
  .hero-title span {
    color: var(--gold);
  }
  .hero-lead {
    font-size: 17px;
    color: var(--text-2);
    max-width: 46ch;
    margin-bottom: 36px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  /* HeroMorph renders a child component root, which Astro's cid scoping
     misses — scope via the ancestor instead. */
  .hero-art :global(.hero-morph) {
    width: 100%;
    max-width: 380px;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    padding: 13px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-gold {
    background: var(--gold);
    color: rgba(0, 0, 0, 0.9);
  }
  .btn-gold:hover {
    background: var(--gold-deep);
  }
  .btn-line {
    border: 1px solid var(--line);
    color: var(--text);
  }
  .btn-line:hover {
    border-color: var(--text-2);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 48px;
  }
  .skill-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.025), transparent 60%);
  }
  .skill-label,
  .install-label {
    color: var(--text-3);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .skill-card code {
    display: inline-block;
    margin: 48px 0 20px;
    color: var(--gold);
    font-size: 18px;
  }
  .skill-card h3,
  .install-card h3 {
    margin-bottom: 12px;
    font-size: 18px;
    line-height: 1.4;
  }
  .skill-card > p:last-child {
    color: var(--text-2);
    font-size: 14px;
  }
  .prompt-hint {
    margin-top: 28px;
  }

  /* 2. Proof — screenshots */
  .shot {
    margin: 0 0 56px;
  }
  .shot:last-child {
    margin-bottom: 0;
  }
  .shot-cap {
    font-size: 14px;
    color: var(--text-2);
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .shot-mode {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--gold-deep);
    border-radius: 999px;
    padding: 3px 12px;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  /* 3. Workflow */
  .steps {
    list-style: none;
    display: grid;
    gap: 4px;
    margin: 0 0 64px;
  }
  .step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 28px 0;
    border-top: 1px solid var(--line-soft);
  }
  .step:first-child {
    border-top: 0;
  }
  .step-marker {
    display: block;
    line-height: 0;
    width: 64px;
    height: 48px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .step-marker :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .step-body h3 {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .step-body p {
    color: var(--text-2);
    font-size: 15px;
    max-width: 62ch;
  }

  .branches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }
  .branch {
    position: relative;
  }
  .branch-tag {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text-3);
    letter-spacing: 0.1em;
  }
  .branch h3 {
    margin-top: 6px;
  }

  /* Get started */
  .install-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .install-card {
    min-width: 0;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .install-card h3 {
    margin-top: 32px;
    min-height: 52px;
  }
  .install-card :global(.copy-command) {
    width: 100%;
  }
  .start-steps {
    counter-reset: step;
    list-style: none;
    display: grid;
    gap: 14px;
    margin: 0 0 40px;
    max-width: 720px;
  }
  .start-steps li {
    position: relative;
    padding-left: 44px;
    padding-top: 4px;
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.8;
  }
  .start-steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 2px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text);
  }
  .start-steps code {
    color: var(--gold);
    font-size: 13px;
    background: var(--gold-tint);
    padding: 1px 7px;
    border-radius: 4px;
  }
  .start-hint {
    color: var(--text-3);
    font-size: 14px;
    margin-bottom: 12px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  /* 7. Beyblade */
  .beyblade .arena-slot {
    background: #05090d;
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .beyblade .arena-slot :global(iframe) {
    width: 100%;
    height: 720px;
    border: 0;
    border-radius: 8px;
  }
  .beyblade #arena-start {
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font-size: 17px;
    padding: 14px 38px;
    border-radius: 999px;
    cursor: pointer;
  }
  .beyblade #arena-start:hover {
    background: var(--gold-tint);
  }

  @media (max-width: 820px) {
    .site-nav nav {
      display: none;
    }
    .version {
      margin-left: auto;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-art {
      order: -1;
    }
    .hero-art :global(.hero-morph) {
      max-width: 260px;
    }
    .skills-grid,
    .install-grid {
      grid-template-columns: 1fr;
    }
    .skill-card {
      min-height: 0;
    }
    .skill-card code {
      margin-top: 32px;
    }
    .install-card h3 {
      min-height: 0;
    }
    .beyblade .arena-slot {
      min-height: 420px;
    }
    .beyblade .arena-slot :global(iframe) {
      height: 600px;
    }
  }

  @media (max-width: 520px) {
    .hero-title {
      font-size: clamp(38px, 12vw, 58px);
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .btn {
      text-align: center;
    }
    .step {
      gap: 16px;
    }
    .step-marker {
      width: 48px;
      height: 38px;
    }
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
