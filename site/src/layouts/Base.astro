---
import '../styles/site.css'
interface Props { title?: string }
const { title = 'WLD Design 插件' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="面向微粒贷设计师和产品经理的 AI 技能包 — 从想法到小程序 demo" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <div class="container">
        <span>WLD Design 插件 · alpha</span>
      </div>
    </footer>
  </body>
</html>
