---
import '../styles/site.css'
interface Props { title?: string }
const {
  title = 'WLD Design 插件 — 从产品档案到可验证的设计方案',
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="WLD Design 插件包含 setup-profile、brainstorm 与 wtf 三个 Skill：维护产品档案，从生产模板生成并验证多个设计方向，再持续批注迭代或进入产品分支。"
    />
    <meta property="og:title" content="WLD Design 插件" />
    <meta
      property="og:description"
      content="从产品档案与生产模板出发，生成、比较、批注并验证移动端 UI 方案。"
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <slot />
  </body>
</html>
