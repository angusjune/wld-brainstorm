---
import '../styles/site.css'
interface Props { title?: string }
const {
  title = '微粒贷设计 Brainstorm — 一个 Skill，从想法到真实产出',
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="微粒贷设计 Brainstorm 是一个自包含的设计 Skill：澄清需求、对齐生产模板、生成 3 个方案，并可继续精简、校验、推送 Figma、生成小程序 Demo。"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <slot />
  </body>
</html>
