.home {
  padding: 32rpx 30rpx 240rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  padding: 72rpx 0 56rpx;
}

.hero__label {
  color: var(--text-secondary);
  font-size: 30rpx;
}

.hero__amount {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1;
}

.hero__meta {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.section {
  margin-top: 34rpx;
}

.section__title {
  margin: 0 0 18rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.offer-card,
.cell-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.offer-card {
  padding: 32rpx;
  background: linear-gradient(180deg, #fff8db 0%, #fff 100%);
}

.offer-card__label {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #fe8400;
  color: #fff;
  font-size: 22rpx;
}

.offer-card__title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.offer-card__desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 60rpx calc(env(safe-area-inset-bottom, 24rpx) + 20rpx);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #fff 18%);
}

.drawer-list {
  padding: 0 24rpx 36rpx;
}
