.wld-checkbox {
    display: flex;
    align-items: center;
    justify-content: center;
}

.wld-checkbox--disabled {
    opacity: 0.4;
}

/* Circle container */
.wld-checkbox__box {
    position: relative;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    border: 4rpx solid #dcdcdc;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
    overflow: hidden;
}

.wld-checkbox__box::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 50%;
    transition: transform 0.1s ease;
    background: #ffd143;
    transform: scale(0);
}

.wld-checkbox__box--checked {
    border-color: #ffd143;
    transition-delay: 0.15s;
}

.wld-checkbox__box--checked::before {
    transform: scale(1);
    transition-duration: 0.15s;
}

/* Checkmark SVG */
.wld-checkbox__tick {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
