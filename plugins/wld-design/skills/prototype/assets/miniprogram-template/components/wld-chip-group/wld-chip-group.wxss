/* components/wld-chip-group/wld-chip-group.wxss */

.wld-chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    padding: 0;
}

.wld-chip-group--disabled {
    opacity: 0.6;
    pointer-events: none;
}

.wld-chip-group__item {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20rpx 30rpx;
    border-radius: 50rpx;
    transition: all 0.2s ease;
    cursor: pointer;
    user-select: none;
    min-height: 60rpx;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.15);
    box-shadow: 0px 0px 1px 0px rgba(0, 0, 0, 0.25) inset;
}

.wld-chip-group__item--hover {
    transform: scale(1.05);
    background: rgba(255, 255, 255, 0.25);
}

.wld-chip-group__item--active {
    font-weight: 500;
    /*background: radial-gradient(84.52% 84.52% at 50% 100%, #FFFEEE 0%, #FFF 31.73%, rgba(255, 255, 255, 0.40) 100%);*/
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
        -1px -1px 1px -1px rgba(255, 255, 255, 0.9) inset,
        1px 1px 1px -1px rgba(255, 255, 255, 0.9) inset;
}

.wld-chip-group__text {
    font-size: 32rpx;
    /* font-weight: 400; */
    line-height: 1.4;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
