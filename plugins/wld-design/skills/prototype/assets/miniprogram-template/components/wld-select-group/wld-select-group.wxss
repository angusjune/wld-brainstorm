.wld-select-group {
    position: relative;
    padding: 0 20rpx;
}

.wld-select {
    display: flex;
    padding: 0 40rpx;
    align-items: flex-start;
    gap: 30rpx;
    align-self: stretch;
    border-radius: 44rpx;
    transition: background 0.1s ease-in-out;
}

.wld-select--hover {
    background: rgba(0, 0, 0, 0.02);
}

.wld-select__icon {
    width: 80rpx;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
}

.wld-select__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10rpx;
    align-self: stretch;
    padding: 40rpx 0;
}

.wld-select__text-title {
    font-size: 32rpx;
}

.wld--select--active .wld-select__text-title {
    font-weight: bold;
}

.wld-select-group__active-indicator {
    position: absolute;
    top: 0;
    left: 20rpx;
    right: 20rpx;
    height: 120rpx;
    border-radius: 44rpx;
    z-index: -1;
    /*background: radial-gradient(60% 60% at 100% 50%, rgba(255, 207, 0, 0.10) 0.16%, rgba(255, 207, 0, 0) 100%), rgba(255, 255, 255, 0.5);*/
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
        -2rpx -2rpx 2rpx -4rpx rgba(255, 255, 255, 1) inset,
        2rpx 2rpx 2rpx -4rpx rgba(255, 255, 255, 1) inset;
    transform: translateY(calc(var(--current-index) * 100%));
    transition: transform calc(var(--index-difference) * 0.1s)
        cubic-bezier(0.34, 1.56, 0.64, 1);
}

.check {
    position: absolute;
    right: 30rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 48rpx;
    aspect-ratio: 1;
    background-image: url("data:image/svg+xml;base64,");
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
}
