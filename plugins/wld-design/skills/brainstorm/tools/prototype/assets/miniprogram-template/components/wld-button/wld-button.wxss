.wld-button {
    position: relative;
    border-radius: 999px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    overflow: hidden;
    transition: 0.1s ease-out;
    transition-property: transform, filter;
    box-sizing: border-box;
}

.wld-button.wld-button--hover {
    transform: scale(1.1);
    filter: saturate(1.3);
}

.wld-button.wld-button--full-width {
    display: flex;
}

.wld-button.wld-button--disabled {
    opacity: 0.4;
    pointer-events: none;
}

.wld-button--primary {
    background: var(--theme-500, #ffd143);
}

.wld-button--xlarge {
  font-size: 40rpx;
  padding: 0 70rpx;
  line-height: 3;
  min-width: 240rpx;
}

.wld-button--large {
    font-size: 36rpx;
    padding: 0 70rpx;
    line-height: 3;
    min-width: 240rpx;
}

.wld-button--normal {
  font-size: 32rpx;
  padding: 0 70rpx;
  line-height: 3;
  min-width: 240rpx;
}

.wld-button--small {
  font-size: 32rpx;
  padding: 0 40rpx;
  line-height: 2.5;
  min-width: 160rpx;
}

.wld-button--xsmall {
  font-size: 28rpx;
  padding: 0 24rpx;
  line-height: 2.28;
}

.wld-button--circle.wld-button--circle {
    width: 168rpx;
    height: 168rpx;
    font-size: 36rpx;
    background: var(--theme-500, #ffd143);
    box-shadow: 0px 6px 10px 0px rgba(237, 192, 109, 0.2);
    min-width: auto;
    line-height: 1;
    padding: 0;
}

.wld-button--circle::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 12rpx solid rgba(255, 204, 0, 0.15);
}

.wld-button__text {
    z-index: 1;
}

.wld-button__glare-wrap {
    position: absolute;
    inset: 0;
    transform-origin: center;
    animation: rotate 10s linear infinite;
    pointer-events: none;
}

.wld-button--circle .wld-button__glare-wrap {
    border-radius: 50%;
    box-shadow: 0 0 2rpx 2rpx #ffe056;
}

@keyframes rotate {
    to {
        transform: rotate(360deg);
    }
}

.wld-button__glare {
    position: absolute;
    filter: blur(40rpx);
    mix-blend-mode: overlay;
    width: 280rpx;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffe056;
}

.wld-button__glare:first-of-type {
    animation: rotate 10s linear reverse infinite;
}
